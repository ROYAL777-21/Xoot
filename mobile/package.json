    "shared:sync": "node ../scripts/build/sync-shared-native.mjs",
    "prestart": "npm run shared:sync",
    "eas-build-post-install": "npm run config:check",
    "test:gift": "tsx --test scripts/native-gift.test.mts"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "metro": "0.84.5",
