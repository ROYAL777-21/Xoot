# Xoot Expo mobile public configuration.
# EXPO_PUBLIC_* values are bundled into the mobile app and are visible to users.
# Keep real secrets out of this file and out of all client-side variables.

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SITE_URL=https://xoot.co.za
# The project ref in EXPO_PUBLIC_SUPABASE_URL must match EXPO_PUBLIC_SUPABASE_PROJECT_ID.
EXPO_PUBLIC_SUPABASE_PROJECT_ID=your-project-ref
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Native mobile pk.* token. Do NOT apply browser URL restrictions: Mapbox native SDK requests are not supported by URL restrictions.
# Required in EAS production; optional during local development / preview to keep other flows testable.
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=
EXPO_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_APPLE_SERVICES_ID=

# Build-time metadata. These are not provider secrets, but still set them in EAS/GitHub rather than hardcoding release values.
EXPO_ACCOUNT_OWNER=
XOOT_MOBILE_VERSION=0.1.0
XOOT_IOS_BUILD_NUMBER=1
XOOT_ANDROID_VERSION_CODE=1
SENTRY_ORG=
SENTRY_MOBILE_PROJECT=xoot-mobile
# Private EAS/GitHub secret for native source-map upload. Never expose as EXPO_PUBLIC_*.
SENTRY_AUTH_TOKEN=
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=
MAPBOX_DOWNLOADS_TOKEN=

# Never add service-role keys, payment secrets, Twilio secrets, Brevo keys, KIE keys,
# OpenAI keys, Airtable tokens, Hostinger tokens, Cloudflare tokens, private keys,
# PostHog phx_* API keys, App Store Connect .p8 contents, or Google Play JSON contents to EXPO_PUBLIC_*.
