# Xoot public frontend configuration. Values in VITE_ are bundled into browser/mobile code.
VITE_APP_ENV=production
VITE_PUBLIC_SITE_URL=http://localhost:5173
VITE_SITE_URL=http://localhost:5173
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SENTRY_DSN=
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_MAPBOX_PUBLIC_TOKEN=
# Off by default: selected suggestions require paid Permanent Geocoding (no free tier).
# Manual address entry and the optional neighbourhood map work without suggestions.
VITE_MAPBOX_ADDRESS_SUGGESTIONS_ENABLED=false
VITE_CALENDAR_SYNC_ENABLED=false
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=
VITE_GOOGLE_WEB_CLIENT_ID=
VITE_APPLE_SERVICES_ID=

# Native app link association generation. Use release signing values only in CI/release builds.
XOOT_APPLE_TEAM_ID=
XOOT_IOS_BUNDLE_ID=za.co.xoot.app
XOOT_IOS_APP_ID=
XOOT_ANDROID_PACKAGE_NAME=za.co.xoot.app
XOOT_ANDROID_SHA256_CERT_FINGERPRINTS=
XOOT_APP_LINK_PATHS=/app/*,/auth/callback*,/auth/reset*,/care-plus/*,/install,/trust-centre,/legal/*,/xooter/*

# Supabase Edge Functions. Set these as Supabase Function secrets or local function env only.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_SUPPORT_MODEL=gpt-4.1-mini

# Payments. Server-side only.
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
STITCH_WEBHOOK_SECRET=
STITCH_PAYMENT_CALLBACK_URL=
STITCH_PAYMENT_SUCCESS_URL=
STITCH_PAYMENT_FAILURE_URL=
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=
OZOW_WEBHOOK_SECRET=
OZOW_NOTIFY_URL=
OZOW_SUCCESS_URL=
OZOW_CANCEL_URL=
OZOW_ERROR_URL=

# Twilio. Server-side only.
