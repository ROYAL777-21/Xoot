VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Supabase Edge Functions. Set as Supabase function secrets, not as public Vite variables.
ALLOWED_ORIGINS="https://zoothome.co.za,https://www.zoothome.co.za,http://localhost:5173,http://127.0.0.1:5173"
SUPABASE_SERVICE_ROLE_KEY="server-side-only-service-role-key"
OPENAI_API_KEY="sk-proj-server-side-only"
OPENAI_SUPPORT_MODEL="gpt-4.1-mini"

# Native app link association generation. Use release signing values only in CI/release builds.
ZOOT_APPLE_TEAM_ID="ABCDE12345"
ZOOT_IOS_BUNDLE_ID="za.co.zoot.app"
# Optional full app id override, for example ABCDE12345.za.co.zoot.app.
ZOOT_IOS_APP_ID=""
ZOOT_ANDROID_PACKAGE_NAME="za.co.zoot.app"
ZOOT_ANDROID_SHA256_CERT_FINGERPRINTS="AA:BB:CC:DD:EE:FF"
ZOOT_APP_LINK_PATHS="/app/*,/auth/callback*,/auth/reset*,/care-plus/*,/install,/trust-centre,/zooter/*"
