# Zoot public frontend configuration. Values in VITE_ are bundled into browser/mobile code.
VITE_APP_ENV=production
VITE_PUBLIC_SITE_URL=http://localhost:5173
VITE_ENABLE_DEMO_MODE=false
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SENTRY_DSN=

# Native app link association generation. Use release signing values only in CI/release builds.
ZOOT_APPLE_TEAM_ID=
ZOOT_IOS_BUNDLE_ID=za.co.zoot.app
ZOOT_IOS_APP_ID=
ZOOT_ANDROID_PACKAGE_NAME=za.co.zoot.app
ZOOT_ANDROID_SHA256_CERT_FINGERPRINTS=
ZOOT_APP_LINK_PATHS=/app/*,/auth/callback*,/auth/reset*,/care-plus/*,/install,/trust-centre,/zooter/*

# Supabase Edge Functions. Set these as Supabase Function secrets or local function env only.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_SUPPORT_MODEL=gpt-4.1-mini

# Payments. Server-side only.
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
STITCH_WEBHOOK_SECRET=
STITCH_PAYMENT_CALLBACK_URL=
STITCH_PAYMENT_SUCCESS_URL=
STITCH_PAYMENT_FAILURE_URL=
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=
OZOW_WEBHOOK_SECRET=
OZOW_NOTIFY_URL=
OZOW_SUCCESS_URL=
OZOW_CANCEL_URL=
OZOW_ERROR_URL=

# Twilio. Server-side only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=
TWILIO_VOICE_WEBHOOK_URL=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_MESSAGE_WEBHOOK_URL=
TWILIO_MASKED_CALL_QUEUE=

# Brevo. Server-side only.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_DOMAIN=
BREVO_SMTP_HOST=
BREVO_SMTP_PORT=
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
BREVO_WEBHOOK_KEY=
BREVO_MARKETING_LIST_ID=
BREVO_TRANSACTIONAL_TEMPLATE_BOOKING_ID=
BREVO_TRANSACTIONAL_TEMPLATE_SUPPORT_ID=

# KIE image/content generation. Server-side only.
KIE_API_KEY=
KIE_MODEL_ID=
KIE_PROMPT_STORAGE_PATH=
KIE_OUTPUT_STORAGE_PATH=

# OAuth provider secrets. Do not expose client secrets in VITE_ variables.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=za.co.zoot.app
APPLE_SERVICES_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_RETURN_URL=

# Monitoring/release. Server-side/CI only unless explicitly public-safe.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_AUTH_TOKEN=
