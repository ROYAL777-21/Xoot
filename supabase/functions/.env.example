# Copy for local Supabase Function development only. Do not commit live values.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Concierge support bot. OpenRouter is primary, OpenAI is the fallback.
OPENROUTER_API_KEY=
CONCIERGE_MODEL=
OPENAI_API_KEY=
OPENAI_SUPPORT_MODEL=gpt-4.1-mini
# Only the literal string "true" turns this on, and only for signed-out callers. The operational
# control `support.turnstile_required` is the other way in and works independently of this.
XOOT_REQUIRE_CONCIERGE_TURNSTILE=false

# Payments — PayFast is the live provider. See NEEDS-FOUNDER.md §1 for where each value comes from
# and which environment gets which merchant.
#
# PAYFAST_MODE is the safety valve: anything that is not exactly "live" means sandbox, so a missing
# or fat-fingered value costs a test payment rather than a real charge.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox
# Optional. PAYFAST_MODE already picks the right host; set these only to override.
PAYFAST_PROCESS_URL=
PAYFAST_VALIDATE_URL=
# Optional. Derived from SUPABASE_URL when unset.
PAYFAST_NOTIFY_URL=
# Optional but recommended, comma-separated. Left empty the ITN source check is skipped and logged.
PAYFAST_ALLOWED_IPS=

# Payments — planned, nothing reads these yet.
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
STITCH_WEBHOOK_SECRET=
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=
OZOW_WEBHOOK_SECRET=

# Sensitive access credential vault (gate codes, alarm codes). No fallback by design: unset means
# `sensitive-access-read` fails closed rather than deriving a key from the service role key.
ENCRYPTION_KEY=

# Environment identity and governance.
#
# ⚠️ XOOT_APP_ENV is not cosmetic. `payment_provider_capabilities` has one row per environment and
# an unlabelled deployment resolves to `production` — so an unset staging project reads production's
# readiness row. Set it to `staging` on staging.
#
# `getEdgeEnvironment` resolves XOOT_APP_ENV -> APP_ENV -> ENVIRONMENT -> "production". Set the
# first. The other two are read for compatibility, and ENVIRONMENT is worth knowing about because
# it is a generic name other tooling likes to set: an ENVIRONMENT=production left on the staging
# project would silently point staging at production's payment readiness row.
XOOT_APP_ENV=
APP_ENV=
# Falls back to SUPABASE_URL, then a constant. Per-environment random value.
XOOT_RATE_LIMIT_HASH_SALT=
# Falls back to ALLOWED_ORIGINS, then the production origin.
APP_BASE_URL=

# Twilio voice, masked calls, and webhook signature validation.
#
# Rewritten 2026-08-09 to match what the code actually reads. This block previously listed six
# variables nothing reads (VERIFY_SERVICE_SID, ORGANIZATION_SID, MESSAGING_SERVICE_SID,
# SMS_SENDER, WHATSAPP_SENDER, SENDGRID_*), named the TwiML app TWILIO_TWIML_APP_SID when the
# code wants TWILIO_VOICE_APP_SID, and omitted TWILIO_CONVERSATIONS_SERVICE_SID entirely — so
# anyone filling it in got a `configured: false` they could not explain.
# `twilio-secrets-contract.test.ts` now fails if this list and the code disagree.

# --- The seven `twilio-token` requires before it will mint anything -------------------
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_CONVERSATIONS_SERVICE_SID=
TWILIO_VOICE_APP_SID=
TWILIO_CALLER_ID=
# The account Auth Token. Every webhook's HMAC-SHA1 check reads it under one of these two names;
# both are accepted everywhere, so either alone is enough. Same value if you set both.
TWILIO_WEBHOOK_AUTH_TOKEN=
TWILIO_AUTH_TOKEN=

# --- The eighth: masked PSTN fallback only -------------------------------------------
TWILIO_PROXY_SERVICE_SID=

# --- Optional. Each has a working fallback; set only if the default is wrong ----------
# `create-masked-call` accepts TWILIO_API_KEY as an alias for TWILIO_API_KEY_SID. Set the _SID name
# above; the alias exists so an older deployment keeps working, not as a second thing to configure.
# Twilio signs the URL it dialled, not the one the function sees. Set these when a proxy or load
# balancer rewrites the host, or every signature check fails silently.
TWILIO_WEBHOOK_BASE_URL=
TWILIO_WEBHOOK_TWIML_URL=
TWILIO_WEBHOOK_STATUS_URL=
# Falls back to SUPABASE_URL. Per-environment random value.
TWILIO_WEBHOOK_HASH_SALT=

# Brevo email and marketing.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_DOMAIN=
BREVO_SMTP_HOST=
BREVO_SMTP_PORT=
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
BREVO_WEBHOOK_KEY=
BREVO_MARKETING_LIST_ID=
BREVO_TRANSACTIONAL_TEMPLATE_BOOKING_ID=
BREVO_TRANSACTIONAL_TEMPLATE_SUPPORT_ID=
BREVO_TRANSACTIONAL_TEMPLATE_INVOICE_ID=
BREVO_TRANSACTIONAL_TEMPLATE_INVOICE_RESEND_ID=

# Completed-booking invoice generation.
#
# ⚠️ Renamed ZOOT_ -> XOOT_ on 2026-08-13. ZD-029 moved the names in
# `generate-booking-invoice/index.ts` and left this file, ENVIRONMENT_SETUP.md and
# SECRETS_INVENTORY.md on the old spelling — so following the documented setup set four variables
# nothing reads, and `getInvoiceLegalConfig` refused every invoice with "invoice legal entity is
# not configured". Failing closed was right; a tax invoice with a blank legal entity would be
# worse. If these were ever set as Supabase secrets under ZOOT_, re-set them under XOOT_.
XOOT_INVOICE_LEGAL_ENTITY=
XOOT_INVOICE_LEGAL_ENTITY_REGISTRATION=
XOOT_INVOICE_VAT_RATE=0
XOOT_INVOICE_VAT_NUMBER=

# KIE generated image/content workflows.
KIE_API_KEY=
KIE_MODEL_ID=
KIE_PROMPT_STORAGE_PATH=
KIE_OUTPUT_STORAGE_PATH=

# OAuth provider backend secrets.
GOOGLE_WEB_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_SERVICES_ID=

# Monitoring and release telemetry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=

# Optional server-side provider/dashboard credentials.
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=
HOSTINGER_API_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_ACCESS_CLIENT_ID=
CLOUDFLARE_ACCESS_CLIENT_SECRET=
MAPBOX_SECRET_TOKEN=
