# Copy this file outside the repository before filling real values.
# Example safe location on Windows: C:\secure\zoot-staging-edge.env
# Never commit the filled file.

SUPABASE_URL=https://fxmxyabdjqviqbcxmvlp.supabase.co
SUPABASE_ANON_KEY=replace-with-staging-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-role-key
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://staging.xoot.co.za

# Optional until the corresponding providers are fully configured.
OPENAI_API_KEY=replace-with-openai-key
OPENAI_SUPPORT_MODEL=gpt-4.1-mini
# Twilio. Use the STAGING subaccount's credentials — never the same values as production, per
# docs/SECRETS_INVENTORY.md. Rewritten 2026-08-09 to match what the code reads; see
# .env.example for what changed and why.
#
# The seven `twilio-token` requires:
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_API_KEY_SID=replace-with-twilio-api-key-sid
TWILIO_API_KEY_SECRET=replace-with-twilio-api-key-secret
TWILIO_CONVERSATIONS_SERVICE_SID=replace-with-twilio-conversations-service-sid
TWILIO_VOICE_APP_SID=replace-with-twilio-twiml-app-sid
TWILIO_CALLER_ID=replace-with-approved-twilio-caller-id
# The account Auth Token, under either name — both are accepted everywhere.
TWILIO_WEBHOOK_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
# The eighth, masked PSTN only:
TWILIO_PROXY_SERVICE_SID=replace-with-twilio-proxy-service-sid-if-used
# Optional, each with a working fallback:
TWILIO_WEBHOOK_BASE_URL=https://fxmxyabdjqviqbcxmvlp.functions.supabase.co
TWILIO_WEBHOOK_HASH_SALT=replace-with-random-per-environment-salt
BREVO_API_KEY=replace-with-brevo-api-key
KIE_API_KEY=replace-with-kie-api-key
STITCH_CLIENT_ID=replace-with-stitch-sandbox-client-id
STITCH_CLIENT_SECRET=replace-with-stitch-sandbox-client-secret
STITCH_WEBHOOK_SECRET=replace-with-stitch-webhook-secret
OZOW_SITE_CODE=replace-with-ozow-sandbox-site-code
OZOW_PRIVATE_KEY=replace-with-ozow-sandbox-private-key
OZOW_API_KEY=replace-with-ozow-sandbox-api-key
AIRTABLE_API_TOKEN=replace-with-airtable-token
AIRTABLE_BASE_ID=replace-with-airtable-base-id
SENTRY_DSN=replace-with-edge-sentry-dsn
