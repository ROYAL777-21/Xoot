{
  "name": "zoot-home-care",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "config:check": "node scripts/config/validate-public-env.mjs",
    "lockfiles:check": "node scripts/config/validate-lockfiles.mjs",
    "prebuild": "npm run config:check && npm run seo:validate && node scripts/build/write-native-association-files.mjs --target public",
    "build": "vite build",
    "postbuild": "node scripts/build/copy-hostinger-files.mjs && node scripts/build/write-native-association-files.mjs --target dist",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:host": "vite preview --host 0.0.0.0",
    "splash:studio": "remotion studio remotion/index.ts",
    "splash:render": "remotion render remotion/index.ts XootSplash public/media/xoot-splash.mp4",
    "splash:still": "remotion still remotion/index.ts XootSplash public/media/xoot-splash-poster.png --frame=0",
    "icons:render": "node scripts/build/render-brand-assets.mjs",
    "shared:sync": "node scripts/build/sync-shared-native.mjs",
    "seo:daily": "node scripts/seo/generate-daily-blog-queue.mjs",
    "seo:sync-release-dates": "node scripts/seo/sync-article-release-dates.mjs",
    "seo:validate": "node scripts/seo/validate-articles.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:scan": "node scripts/security/secret-scan.mjs && node scripts/security/assert-no-frontend-admin-queue-writes.mjs && node scripts/security/assert-no-unsafe-dom-apis.mjs && node scripts/security/assert-static-hosting-security.mjs",
    "build:artifact-scan": "node scripts/security/scan-build-artifacts.mjs dist",
    "verify": "npm run lockfiles:check && npm run lint && npm run test && npm run build && npm run build:artifact-scan && npm run security:scan",
    "load:test": "k6 run scripts/load/zoot-smoke.js",
    "load:test:10k:staging": "k6 run scripts/load/zoot-staging-10k-readiness.js",
    "mobile:install": "npm --prefix mobile ci",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:start:dev-client": "npm --prefix mobile run start:dev-client",
    "mobile:ios": "npm --prefix mobile run ios",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:web": "npm --prefix mobile run web",
    "mobile:config:check": "npm --prefix mobile run config:check",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "mobile:build:preview:ios": "npm --prefix mobile run build:preview:ios",
    "mobile:build:preview:android": "npm --prefix mobile run build:preview:android",
    "mobile:build:production": "npm --prefix mobile run build:production",
    "ops:github-vars": "powershell -ExecutionPolicy Bypass -File scripts/ops/set-github-public-vars.ps1",
    "ops:blockers:check": "powershell -ExecutionPolicy Bypass -File scripts/ops/check-blocker-ledger.ps1",
    "ops:mobile:preview-smoke": "powershell -ExecutionPolicy Bypass -File scripts/ops/mobile-preview-smoke.ps1",
    "ops:provider-auth:check": "powershell -ExecutionPolicy Bypass -File scripts/ops/check-local-provider-auth.ps1",
    "ops:provider-auth:setup": "powershell -ExecutionPolicy Bypass -File scripts/ops/setup-local-provider-auth.ps1",
    "ops:readiness": "powershell -ExecutionPolicy Bypass -File scripts/ops/verify-production-readiness.ps1",
    "ops:smoke:staging": "node scripts/ops/staging-role-smoke.mjs",
    "ops:supabase:auth-config": "powershell -ExecutionPolicy Bypass -File scripts/ops/set-supabase-auth-config.ps1",
    "ops:supabase:drift-check": "powershell -ExecutionPolicy Bypass -File scripts/ops/check-supabase-metadata-drift.ps1",
    "ops:supabase:deployed-drift": "node scripts/ops/check-deployed-drift.mjs",
    "ops:supabase:allowed-origins": "node scripts/ops/set-allowed-origins.mjs",
    "ops:supabase:deploy:staging": "powershell -ExecutionPolicy Bypass -File scripts/ops/deploy-staging-backend.ps1",
    "ops:supabase:deploy:production": "powershell -ExecutionPolicy Bypass -File scripts/ops/deploy-production-backend.ps1",
    "ops:supabase:repair-migrations": "powershell -ExecutionPolicy Bypass -File scripts/ops/repair-supabase-migration-history.ps1",
    "ops:supabase:secrets:staging": "powershell -ExecutionPolicy Bypass -File scripts/ops/set-supabase-edge-secrets.ps1",
    "ops:supabase:secrets:production": "powershell -ExecutionPolicy Bypass -File scripts/ops/set-supabase-edge-secrets.ps1 -ProjectRef mvlrkelahhsyjrwgsxaf",
    "ops:supabase:encryption-key": "powershell -ExecutionPolicy Bypass -File scripts/ops/set-encryption-key.ps1",
    "ops:supabase:verify:live": "powershell -ExecutionPolicy Bypass -File scripts/ops/verify-supabase-live.ps1",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "kit:tokens": "node scripts/build/extract-kit-tokens.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@sentry/react": "^10.57.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@supabase/supabase-js": "^2.104.0",
    "@tanstack/react-query": "^5.83.0",
    "@twilio/voice-sdk": "^2.18.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "dompurify": "^3.4.11",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.43.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.462.0",
    "mapbox-gl": "^3.25.0",
    "next-themes": "^0.3.0",
    "posthog-js": "^1.395.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.61.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@remotion/cli": "4.0.501",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.28.1",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "form-data": "^4.0.6",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "postcss": "^8.5.6",
    "remotion": "4.0.501",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
